# 生产环境配置 - GitHub Pages
VITE_APP_NAME=LiVin Matrix
VITE_APP_DESCRIPTION=Life Vitality Interconnection Matrix - 生活活力互联矩阵
VITE_ENVIRONMENT=production

# API配置
VITE_API_BASE_URL=https://api.livin-matrix.example.com
VITE_API_VERSION=v1
VITE_API_TIMEOUT=10000

# GitHub Pages特定配置
VITE_GITHUB_PAGES=true
VITE_BASE_URL=/

# 应用功能开关
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_SENTRY=false
VITE_ENABLE_HOTJAR=false

# 安全配置
VITE_ENABLE_CSP=true
VITE_ENABLE_HTTPS_ONLY=true

# 缓存配置
VITE_CACHE_VERSION=1
VITE_SW_CACHE_NAME=livin-matrix-v1

# 第三方服务（生产环境不包含密钥）
# VITE_GOOGLE_ANALYTICS_ID=
# VITE_SENTRY_DSN=
# VITE_HOTJAR_ID=

# 调试配置
VITE_DEBUG_MODE=false
VITE_SHOW_DEV_TOOLS=false
VITE_LOG_LEVEL=error

# 性能配置
VITE_LAZY_LOADING=true
VITE_CODE_SPLITTING=true
VITE_PRELOAD_ROUTES=true

# UI配置
VITE_THEME_DEFAULT=light
VITE_ENABLE_DARK_MODE=true
VITE_ANIMATION_ENABLED=true
VITE_REDUCE_MOTION=false

# 数据配置
VITE_MAX_FILE_SIZE=10485760
VITE_PAGINATION_SIZE=20
VITE_MAX_PAGINATION_SIZE=100

# 国际化配置
VITE_DEFAULT_LOCALE=zh-CN
VITE_SUPPORTED_LOCALES=zh-CN,en-US

# 矩阵配置
VITE_MATRIX_DIMENSIONS=6
VITE_CORRELATION_THRESHOLD=0.1
VITE_DEFAULT_TIME_RANGE=30