{
  "name": "livin-matrix",
  "version": "1.0.0",
  "description": "LiVin Matrix - 生活数据相关性分析平台",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "docker-compose up -d",
    "dev:frontend": "cd frontend && npm start",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "clean": "docker-compose down && docker system prune -f",
    "install:all": "npm install && npm install --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/livin-matrix.git"
  },
  "author": "LiVin Matrix Team",
  "license": "MIT",
  "keywords": [
    "data-analysis",
    "correlation",
    "react",
    "fastapi",
    "typescript",
    "python"
  ]
}