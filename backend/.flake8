[flake8]
max-line-length = 88
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    alembic/versions/*,
    migrations

ignore =
    E501,
    W503,
    W291,
    W293,
    F401,
    E402

per-file-ignores =
    __init__.py:F401
    alembic/env.py:E402,F401
    */migrations/*.py:E501,F401
    tests/*.py:F401,F841
