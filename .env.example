# LiVin Matrix 环境配置模板
# 复制此文件为 .env.production 并填写实际值
# 注意: 生产环境中请使用强密码和真实的密钥

# PostgreSQL 数据库配置
POSTGRES_PASSWORD=your-secure-postgres-password

# JWT 配置
JWT_SECRET_KEY=your-super-secret-jwt-key-at-least-32-characters-long
SESSION_SECRET_KEY=your-super-secret-session-key-at-least-32-characters-long

# GitHub OAuth 配置
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URI=https://your-domain.com/api/v1/auth/github/callback

# 邮件服务配置 (Resend)
RESEND_API_KEY=your-resend-api-key

# 应用环境配置
ENVIRONMENT=production
DEBUG=false
HTTPS_ONLY=false
SECURE_COOKIES=true

# 前端配置
FRONTEND_API_URL=http://your-server-ip:8000

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 日志配置
LOG_LEVEL=INFO

# 数据库连接池配置
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
